{
  "name": "type-inference-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "wasm:dev": "node scripts/build-wasm.mjs --dev",
    "wasm:build": "node scripts/build-wasm.mjs --release",
    "dev": "npm run wasm:dev && vite --config web/vite.config.ts",
    "typecheck": "tsc --project web/tsconfig.json",
    "build": "npm run wasm:build && npm run typecheck && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
